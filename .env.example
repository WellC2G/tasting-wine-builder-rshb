# =============================================================================
# Tasting Constructor — environment template
# Copy this file to `.env` and replace every placeholder secret before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=tasting
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasting_constructor
POSTGRES_PORT=5432

# Host used by the API when it runs outside Docker Compose.
# Inside Compose the API always connects to the `postgres` service on port 5432.
POSTGRES_HOST=localhost

# -----------------------------------------------------------------------------
# API (NestJS)
# The API listens on 0.0.0.0:4000 inside the container. API_PORT only changes
# the host port exposed by Docker Compose.
# -----------------------------------------------------------------------------
API_PORT=4000
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVER_SALT=change-me-server-salt-for-guest-fingerprints

# -----------------------------------------------------------------------------
# People's Wine Rating export adapter
# The default points at the built-in mock receiver on the API's own loopback,
# so export keeps working inside Docker regardless of the host LAN address.
# -----------------------------------------------------------------------------
PEOPLES_RATING_WEBHOOK_URL=http://127.0.0.1:4000/api/v1/mock/peoples-rating/batch

# -----------------------------------------------------------------------------
# Client (Next.js)
# The browser chooses the API hostname at runtime from window.location.hostname,
# so phones and tablets work through any LAN IP without editing this value and
# without rebuilding images when the Wi-Fi network changes.
# This URL is only a protocol/port hint; the port defaults to 4000. Malformed
# values without http:// (for example 192.168.1.50:4000) are normalized safely.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

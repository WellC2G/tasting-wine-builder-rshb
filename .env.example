# =============================================================================
# Tasting Constructor — environment template
# Copy this file to `.env` and replace every placeholder secret before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=tasting
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tasting_constructor
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVER_SALT=change-me-server-salt-for-guest-fingerprints

# -----------------------------------------------------------------------------
# People's Wine Rating export adapter
# The default points at the built-in mock receiver served by the API itself.
# -----------------------------------------------------------------------------
PEOPLES_RATING_WEBHOOK_URL=http://localhost:4000/api/v1/mock/peoples-rating/batch

# -----------------------------------------------------------------------------
# Client (Next.js)
# Must be reachable from the browser, not only from inside the Docker network.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
